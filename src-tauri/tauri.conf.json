{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Wipzi",
  "version": "0.1.1",
  "identifier": "com.kacheo.wipzi",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "overlay",
        "url": "overlay.html",
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "visible": false,
        "width": 320,
        "height": 100
      },
      {
        "label": "prefs",
        "url": "prefs.html",
        "title": "Wipzi Preferences",
        "visible": false,
        "resizable": false,
        "width": 500,
        "height": 560
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "dmg",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "Entitlements.plist",
      "infoPlist": "Info.plist"
    }
  }
}
