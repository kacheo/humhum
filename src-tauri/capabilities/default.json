{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions for overlay and prefs windows",
  "windows": [
    "overlay",
    "prefs"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/kacheo/humhum" }]
    }
  ]
}
