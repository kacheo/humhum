# Local signed-build secrets for scripts/build-release.sh.
# Copy to .env.local and fill in real values. .env.local is gitignored —
# never commit real values (APPLE_PASSWORD is a secret).
#
# For a LOCAL signed build the certificate is read from your login keychain,
# so APPLE_CERTIFICATE / APPLE_CERTIFICATE_PASSWORD are NOT needed here — those
# exist only as CI secrets so the runner can import the cert.

APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
APPLE_ID="your-apple-id@example.com"
APPLE_TEAM_ID="TEAMID1234"
APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"   # app-specific password from appleid.apple.com
